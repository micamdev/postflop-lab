{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "copyright": "Copyright (C) 2022 Wataru Inariba, 2026 Michael Maccio",
    "targets": ["msi", "deb", "appimage"],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "11.7"
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Postflop Lab",
  "version": "../package.json",
  "identifier": "dev.micam.postflop-lab",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDOTlCQjRFQ0RFRTVENDkKUldSSlhlN05UcnVaM0JXc0UzVXVoSE1IdXdabyt3L1dhcm0yOGg5QTloWlRyZzgra2dHM3QwNkcK",
      "endpoints": [
        "https://github.com/micamdev/postflop-lab/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Postflop Lab",
        "width": 1600,
        "height": 950,
        "minWidth": 1280,
        "minHeight": 720,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  }
}